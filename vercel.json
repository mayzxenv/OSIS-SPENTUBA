{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://019bd78e-c6c9-70be-99f0-e319b1d30389.osis-spentuba.workers.dev/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
